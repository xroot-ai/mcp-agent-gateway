# Copy to .env and fill in. Never commit .env.

# Model access (read by the Anthropic SDK)
ANTHROPIC_API_KEY=
# No key yet? GW_OFFLINE_LLM=true runs a demo mode: retrieval-only answers, keyword guardrails.
# GW_OFFLINE_LLM=true

# Gateway bearer tokens -> users and scopes. Use long random strings.
GW_API_TOKENS={"replace-with-a-long-random-token": {"user_id": "demo", "scopes": ["tickets:write"]}}

# Shared secrets between the gateway and each MCP server (same value on both sides)
RETRIEVAL_TOKEN=replace-with-a-long-random-token
TICKETS_TOKEN=replace-with-a-long-random-token

# Local (non-Docker) runs: leave these unset to run both MCP servers in-process (local://)
# RETRIEVAL_MCP_URL=http://localhost:8101/mcp
# TICKETS_MCP_URL=http://localhost:8102/mcp
# RETRIEVAL_QDRANT_URL=http://localhost:6333

# Optional tracing: any OTLP/HTTP collector, e.g. the Jaeger in the "otel" compose profile
# GW_OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Optional Langfuse (spans are sent to its OTLP endpoint)
# GW_LANGFUSE_HOST=https://cloud.langfuse.com
# GW_LANGFUSE_PUBLIC_KEY=
# GW_LANGFUSE_SECRET_KEY=
